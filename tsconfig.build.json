{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "templates",
    "documentacion",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
